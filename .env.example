# Local development uses the Postgres container defined in compose.yaml.
# In production point this at your hosted database (for example a Neon connection string).
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk"

# Signs session cookies and password-reset tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"

# Optional. Left unset, the origin is worked out automatically: localhost in
# development, and Vercel's own VERCEL_PROJECT_PRODUCTION_URL once deployed.
# BETTER_AUTH_URL="https://your-app.vercel.app"

# The password-reset link is shown on the page in every environment, so no variable
# controls it. See SHOW_RESET_LINK in src/lib/reset-links.ts to put it back behind one.
