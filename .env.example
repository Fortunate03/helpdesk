# Local development uses the Postgres container defined in compose.yaml.
# In production point this at your hosted database (for example a Neon connection string).
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk"

# Signs session cookies and password-reset tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo only. Shows the password-reset link on the page instead of emailing it.
# On automatically in development. Setting this to true in production lets anyone
# reset any account, including an administrator's, so leave it unset when deployed.
# DEMO_SHOW_RESET_LINK="true"
